    "include": [
      "website/UI galleries with browseable examples",
      "landing/dashboard/SaaS galleries",
      "component/animation library SHOWCASE or demo pages (viewport screenshot)",
      "design-system marketing/docs visual pages",
      "flow libraries with public screens (when scrapable/screenshotable)"
    ],
    "exclude_from_inspiration_collect": [
      "pure package registries / npm only",
      "icon packs without UI composition (prefer Resource Intelligence)",
      "font directories (prefer Resource Intelligence)",
      "AI builder tools as generation engines (optional live_site only)"
    ],
    "tiers": {
      "fast_http": "CDN/list HTML yields preview image URLs without Chromium",
      "browser_gallery": "Needs headed/SPA extract or WAF",
      "screenshot_demo": "Navigate a curated demo URL and viewport-capture",
      "flow_library": "Screen/flow archives — prefer screenshot or licensed API later",
      "research_only": "Useful human research; not default MCP cascade yet"
    }
  },
